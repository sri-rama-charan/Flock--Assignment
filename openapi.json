{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy API",
    "description": "Clean REST API wrapper around the Urja Meter Ops distribution metering portal.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Verify that the API service is alive and healthy.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "summary": "List & Search Meters",
        "description": "Retrieve paginated meter records, optionally filtered by search text (serial number, meter ID, make, etc.).",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (must be an integer >= 1).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search term matching serialNo, meterId, or make.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Alias for search parameter.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of meter records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                },
                "example": {
                  "data": [
                    {
                      "meterId": "J100000",
                      "serialNo": "SE33962",
                      "make": "HPL",
                      "phaseType": "single",
                      "installStatus": "Decommissioned",
                      "dtCode": "DT-001"
                    }
                  ],
                  "total": 403,
                  "page": 1,
                  "pageSize": 20
                }
              }
            }
          },
          "400": {
            "description": "Invalid input query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Invalid page: page must be a positive integer greater than or equal to 1."
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal communication failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Upstream portal timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meterId}": {
      "get": {
        "summary": "Get Meter Details",
        "description": "Retrieve nameplate specifications and electrical grid hierarchy for a single meter.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "description": "Unique meter identifier (e.g. J100000)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter details and hierarchy retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailsResponse"
                },
                "example": {
                  "meterId": "J100000",
                  "detail": {
                    "data": [
                      { "parameterName": "Meter ID", "parameterValue": "J100000" },
                      { "parameterName": "Serial No", "parameterValue": "SE33962" },
                      { "parameterName": "Make", "parameterValue": "HPL" },
                      { "parameterName": "Phase Type", "parameterValue": "single" },
                      { "parameterName": "Installation Status", "parameterValue": "Decommissioned" },
                      { "parameterName": "Installation Type", "parameterValue": "Whole Current" }
                    ]
                  },
                  "hierarchy": {
                    "Meter ID": "J100000",
                    "Installation Status": "Decommissioned",
                    "Installation Type": "Whole Current",
                    "Zone": "Jaipur Zone 1 (Z-01)",
                    "Circle": "Circle 1 (C-01)",
                    "Division": "Division 1 (D-01)",
                    "Subdivision": "Subdivision 1 (SD-01)",
                    "Sub Station": "Substation 1 (SS-01)",
                    "Feeder": "Feeder 1 (F-001)",
                    "DT": "Malviya Nagar DT 1 (DT-001)"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter ID supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Invalid meterId: meterId must be a non-empty string."
                }
              }
            }
          },
          "404": {
            "description": "Meter not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Meter not found"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/location": {
      "get": {
        "summary": "Get Meter Location",
        "description": "Retrieve geographic coordinates (latitude and longitude) for a single meter.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "description": "Unique meter identifier (e.g. J100000)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter geographic coordinates retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterLocationResponse"
                },
                "example": {
                  "latitude": "26.938961002479868",
                  "longitude": "75.83095696146852",
                  "data": {
                    "latitude": "26.938961002479868",
                    "longitude": "75.83095696146852"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter ID supplied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Invalid meterId: meterId must be a non-empty string."
                }
              }
            }
          },
          "404": {
            "description": "Location not found for meter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Location not found for meter 'NON_EXISTENT_MTR'."
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "MeterSummary": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "serialNo": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phaseType": {
            "type": "string",
            "example": "single"
          },
          "installStatus": {
            "type": "string",
            "example": "Decommissioned"
          },
          "dtCode": {
            "type": "string",
            "example": "DT-001"
          }
        },
        "required": ["meterId", "serialNo", "make", "phaseType", "installStatus", "dtCode"]
      },
      "MeterListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeterSummary"
            }
          },
          "total": {
            "type": "integer",
            "example": 403
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          }
        },
        "required": ["data", "total", "page", "pageSize"]
      },
      "NameplateParameter": {
        "type": "object",
        "properties": {
          "parameterName": {
            "type": "string",
            "example": "Serial No"
          },
          "parameterValue": {
            "type": "string",
            "example": "SE33962"
          }
        },
        "required": ["parameterName", "parameterValue"]
      },
      "MeterDetailsResponse": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "detail": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NameplateParameter"
                }
              }
            }
          },
          "hierarchy": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "Zone": "Jaipur Zone 1 (Z-01)",
              "Circle": "Circle 1 (C-01)",
              "Division": "Division 1 (D-01)",
              "Subdivision": "Subdivision 1 (SD-01)",
              "Sub Station": "Substation 1 (SS-01)",
              "Feeder": "Feeder 1 (F-001)",
              "DT": "Malviya Nagar DT 1 (DT-001)"
            }
          }
        },
        "required": ["meterId", "detail", "hierarchy"]
      },
      "MeterLocationResponse": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "string",
            "example": "26.938961002479868"
          },
          "longitude": {
            "type": "string",
            "example": "75.83095696146852"
          },
          "data": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "string",
                "example": "26.938961002479868"
              },
              "longitude": {
                "type": "string",
                "example": "75.83095696146852"
              }
            }
          }
        },
        "required": ["latitude", "longitude"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Meter not found"
          }
        },
        "required": ["error"]
      }
    }
  }
}
