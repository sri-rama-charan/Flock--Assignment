{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy API",
    "description": "Clean REST API wrapper around the Urja Meter Ops distribution metering portal.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Verify that the API service is alive and healthy.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "summary": "List & Search Meters",
        "description": "Retrieve paginated meter records, optionally filtered by search text (serial number, meter ID, or make). When both 'search' and 'q' query parameters are provided, 'search' takes precedence.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (must be an integer between 1 and 1,000,000). Defaults to 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search term matching serialNo, meterId, or make (max 200 characters). Takes precedence over 'q' if both are provided.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Alternative query parameter matching serialNo, meterId, or make (max 200 characters). Ignored if 'search' is also provided.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of meter records retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                },
                "example": {
                  "data": [
                    {
                      "meterId": "J100000",
                      "serialNo": "SE33962",
                      "make": "HPL",
                      "phaseType": "single",
                      "installStatus": "Decommissioned",
                      "dtCode": "DT-001"
                    }
                  ],
                  "total": 403,
                  "page": 1,
                  "pageSize": 20
                }
              }
            }
          },
          "400": {
            "description": "Invalid input query parameters (e.g. invalid page, non-string search, or search query exceeding 200 characters)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_PAGE",
                    "message": "Invalid page: page must be a positive integer between 1 and 1,000,000."
                  }
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal communication failure, authentication rejection, or malformed response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UPSTREAM_AUTH_FAILED",
                    "message": "Urja Ops portal authentication failed."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Upstream service unavailable (connection failure / DNS error) or rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UPSTREAM_UNAVAILABLE",
                    "message": "Unable to connect to the Urja Ops portal. Please check network connection and portal availability."
                  }
                }
              }
            }
          },
          "504": {
            "description": "Upstream portal request timed out (10s threshold)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UPSTREAM_TIMEOUT",
                    "message": "Urja Ops portal request timed out. Please try again later."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "An unexpected internal server error occurred."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meterId}": {
      "get": {
        "summary": "Get Meter Details",
        "description": "Retrieve nameplate specifications and electrical grid hierarchy for a single meter.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "description": "Unique meter identifier (e.g. J100000, max 100 characters).",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter details and hierarchy retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailsResponse"
                },
                "example": {
                  "meterId": "J100000",
                  "detail": {
                    "data": [
                      { "parameterName": "Meter ID", "parameterValue": "J100000" },
                      { "parameterName": "Serial No", "parameterValue": "SE33962" },
                      { "parameterName": "Make", "parameterValue": "HPL" },
                      { "parameterName": "Phase Type", "parameterValue": "single" },
                      { "parameterName": "Installation Status", "parameterValue": "Decommissioned" },
                      { "parameterName": "Installation Type", "parameterValue": "Whole Current" }
                    ]
                  },
                  "hierarchy": {
                    "Meter ID": "J100000",
                    "Installation Status": "Decommissioned",
                    "Installation Type": "Whole Current",
                    "Zone": "Jaipur Zone 1 (Z-01)",
                    "Circle": "Circle 1 (C-01)",
                    "Division": "Division 1 (D-01)",
                    "Subdivision": "Subdivision 1 (SD-01)",
                    "Sub Station": "Substation 1 (SS-01)",
                    "Feeder": "Feeder 1 (F-001)",
                    "DT": "Malviya Nagar DT 1 (DT-001)"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter ID supplied (empty, whitespace-only, illegal characters, or exceeding 100 characters)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_METER_ID",
                    "message": "Invalid meterId: meterId must be a non-empty string."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Meter not found in the upstream portal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "METER_NOT_FOUND",
                    "message": "Meter 'NON_EXISTENT_MTR' not found on Urja Ops portal."
                  }
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal communication failure, authentication rejection, or malformed payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UPSTREAM_INVALID_RESPONSE",
                    "message": "Invalid response received from Urja Ops portal."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Upstream service unavailable (connection failure / DNS error) or rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UPSTREAM_UNAVAILABLE",
                    "message": "Unable to connect to the Urja Ops portal. Please check network connection and portal availability."
                  }
                }
              }
            }
          },
          "504": {
            "description": "Upstream portal request timed out (10s threshold)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UPSTREAM_TIMEOUT",
                    "message": "Urja Ops portal request timed out. Please try again later."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "An unexpected internal server error occurred."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/location": {
      "get": {
        "summary": "Get Meter Location",
        "description": "Retrieve geographic coordinates (latitude and longitude) for a single meter.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "description": "Unique meter identifier (e.g. J100000, max 100 characters).",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter geographic coordinates retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterLocationResponse"
                },
                "example": {
                  "latitude": "26.938961002479868",
                  "longitude": "75.83095696146852",
                  "data": {
                    "latitude": "26.938961002479868",
                    "longitude": "75.83095696146852"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter ID supplied (empty, whitespace-only, illegal characters, or exceeding 100 characters)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_METER_ID",
                    "message": "Invalid meterId: meterId must be a non-empty string."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Location coordinates not found for requested meter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "LOCATION_NOT_FOUND",
                    "message": "Location not found for meter 'NON_EXISTENT_MTR'."
                  }
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal communication failure, malformed payload, or out-of-range coordinates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_LOCATION_COORDINATES",
                    "message": "Location coordinates for meter 'J100000' are outside valid geographic range."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Upstream service unavailable (connection failure / DNS error) or rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UPSTREAM_UNAVAILABLE",
                    "message": "Unable to connect to the Urja Ops portal. Please check network connection and portal availability."
                  }
                }
              }
            }
          },
          "504": {
            "description": "Upstream portal request timed out (10s threshold)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UPSTREAM_TIMEOUT",
                    "message": "Urja Ops portal request timed out. Please try again later."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "An unexpected internal server error occurred."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "MeterSummary": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "serialNo": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phaseType": {
            "type": "string",
            "example": "single"
          },
          "installStatus": {
            "type": "string",
            "example": "Decommissioned"
          },
          "dtCode": {
            "type": "string",
            "example": "DT-001"
          }
        },
        "required": ["meterId", "serialNo", "make", "phaseType", "installStatus", "dtCode"]
      },
      "MeterListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeterSummary"
            }
          },
          "total": {
            "type": "integer",
            "example": 403
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          }
        },
        "required": ["data", "total", "page", "pageSize"]
      },
      "NameplateParameter": {
        "type": "object",
        "properties": {
          "parameterName": {
            "type": "string",
            "example": "Serial No"
          },
          "parameterValue": {
            "type": "string",
            "example": "SE33962"
          }
        },
        "required": ["parameterName", "parameterValue"]
      },
      "MeterDetailsResponse": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "detail": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NameplateParameter"
                }
              }
            },
            "required": ["data"]
          },
          "hierarchy": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "Zone": "Jaipur Zone 1 (Z-01)",
              "Circle": "Circle 1 (C-01)",
              "Division": "Division 1 (D-01)",
              "Subdivision": "Subdivision 1 (SD-01)",
              "Sub Station": "Substation 1 (SS-01)",
              "Feeder": "Feeder 1 (F-001)",
              "DT": "Malviya Nagar DT 1 (DT-001)"
            }
          }
        },
        "required": ["meterId", "detail", "hierarchy"]
      },
      "MeterLocationResponse": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "string",
            "example": "26.938961002479868"
          },
          "longitude": {
            "type": "string",
            "example": "75.83095696146852"
          },
          "data": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "string",
                "example": "26.938961002479868"
              },
              "longitude": {
                "type": "string",
                "example": "75.83095696146852"
              }
            },
            "required": ["latitude", "longitude"]
          }
        },
        "required": ["latitude", "longitude", "data"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "METER_NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "Meter 'NON_EXISTENT_MTR' not found on Urja Ops portal."
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    }
  }
}
